<view class="page">
  <view class="title">滑雪保险</view>
  <view class="subtitle">为雪场出行、装备使用和训练课程提供保障说明。</view>

  <view class="section card" wx:for="{{plans}}" wx:key="name">
    <view class="title-row">
      <view class="item-title">{{item.name}}</view>
      <view class="price">¥{{item.price}}</view>
    </view>
    <view class="subtitle">{{item.desc}}</view>
    <button class="ghost-btn action" hover-class="tap-hover" data-name="{{item.name}}" bindtap="choose">查看方案</button>
  </view>
</view>
