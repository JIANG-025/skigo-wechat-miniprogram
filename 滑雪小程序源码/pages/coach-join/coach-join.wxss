.join-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
  box-shadow: 0 12rpx 34rpx rgba(42, 61, 102, 0.07);
}

.hero-label {
  color: #165dff;
  font-size: 21rpx;
  font-weight: 900;
}

.hero-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
}

.form-card {
  padding-bottom: 34rpx;
}

.notice {
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fff7e8;
  color: #9a5a00;
  font-size: 24rpx;
  line-height: 1.6;
}

.field-label {
  margin: 22rpx 0 12rpx;
  font-size: 25rpx;
  font-weight: 900;
  color: #172033;
}

.picker-box {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  background: #eef3fb;
  border: 1rpx solid #e6eefb;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #38445a;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  height: 180rpx;
  border-radius: 20rpx;
  background: #eef3fb;
  border: 1rpx solid #e6eefb;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.submit {
  margin-top: 30rpx;
}
