<view class="page">
  <view class="title">酒店预定</view>
  <view class="subtitle">展示雪场周边酒店和预订信息。</view>
  <view class="section card hotel-card" hover-class="tap-hover" wx:for="{{hotels}}" wx:key="id" bindtap="goDetail">
    <view class="item-title">{{item.name}}</view>
    <view class="subtitle">{{item.desc}}</view>
    <view class="price">¥{{item.price}} 起/晚</view>
  </view>
</view>
