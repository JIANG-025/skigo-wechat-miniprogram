<view class="page">
  <view class="title">搜索</view>
  <view class="subtitle">输入雪场、酒店、装备或教练，系统会给出智能推荐。</view>
  <input class="search-input" value="{{keyword}}" bindinput="onInput" placeholder="搜索雪场、酒店、装备、教练" />

  <view class="section card recommend-card">
    <view class="title-row">
      <view class="title">智能推荐</view>
      <view class="tag">智能匹配</view>
    </view>
    <view class="subtitle">{{recommendTip}}</view>
  </view>

  <view class="section card">
    <view class="title-row"><view class="title">热门搜索</view></view>
    <view class="tags">
      <view class="tag-item" hover-class="tap-hover" wx:for="{{hotWords}}" wx:key="*this" data-word="{{item}}" bindtap="chooseWord">{{item}}</view>
    </view>
  </view>

  <view class="section">
    <view class="soft-row" hover-class="tap-hover" wx:for="{{results}}" wx:key="title" data-url="{{item.url}}" bindtap="goPage">
      <view class="item-title">{{item.title}}</view>
      <view class="subtitle">{{item.type}} · {{item.desc}}</view>
    </view>
  </view>
</view>
