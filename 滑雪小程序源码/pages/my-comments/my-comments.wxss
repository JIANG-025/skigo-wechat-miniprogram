.page-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
  box-shadow: 0 12rpx 34rpx rgba(42, 61, 102, 0.07);
}

.hero-label {
  color: #165dff;
  font-size: 21rpx;
  font-weight: 900;
}

.hero-icon,
.empty-icon {
  border-radius: 18rpx;
}

.hero-icon {
  width: 76rpx;
  height: 76rpx;
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
}

.empty-title,
.item-title {
  font-size: 28rpx;
  font-weight: 900;
}

.action {
  margin-top: 24rpx;
}

.comment-card {
  margin-bottom: 18rpx;
  position: relative;
  overflow: hidden;
}

.comment-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 8rpx;
  border-radius: 999rpx;
  background: #165dff;
}

.content {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #38445a;
}

.bottom-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
