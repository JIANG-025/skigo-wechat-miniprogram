.category-row {
  margin-top: 22rpx;
  white-space: nowrap;
}

.category {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #627089;
  font-size: 24rpx;
  font-weight: 800;
}

.category.active {
  background: #165dff;
  color: #ffffff;
}

.list-summary {
  margin-top: 18rpx;
  color: #7a8496;
  font-size: 24rpx;
}

.coach-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #165dff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
}

.coach-main {
  flex: 1;
}

.item-title {
  font-size: 28rpx;
  font-weight: 800;
}

.tag-list {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-list text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #165dff;
  font-size: 21rpx;
  font-weight: 800;
}

.coach-meta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.coach-meta text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f7ff;
  color: #607089;
  font-size: 22rpx;
  font-weight: 700;
}

.card-bottom {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.book-chip {
  min-width: 112rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  text-align: center;
  background: #165dff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}
