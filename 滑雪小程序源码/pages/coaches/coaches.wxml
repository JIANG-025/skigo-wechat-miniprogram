<view class="page">
  <view class="title">预约教练</view>
  <view class="subtitle">查看教练资质、擅长方向和课时价格。</view>

  <scroll-view scroll-x class="category-row">
    <view wx:for="{{categories}}" wx:key="*this" data-category="{{item}}" bindtap="chooseCategory" hover-class="tap-hover" class="category {{activeCategory === item ? 'active' : ''}}">{{item}}</view>
  </scroll-view>
  <view class="list-summary">共 {{filteredCoaches.length}} 位{{activeCategory === '全部' ? '认证教练' : activeCategory}}</view>

  <view class="section card coach-card" hover-class="tap-hover" wx:for="{{filteredCoaches}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
    <view class="coach-main">
      <view class="item-title">{{item.name}} <text class="tag">{{item.level}}</text></view>
      <view class="subtitle">{{item.resort}} · {{item.category}}</view>
      <view class="tag-list">
        <text wx:for="{{item.teachTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="coach-meta">
        <text>{{item.rating}} 分</text>
        <text>{{item.reviews}} 评价</text>
        <text>{{item.years}} 年经验</text>
      </view>
      <view class="card-bottom">
        <view class="price">¥{{item.price}}/课时</view>
        <view class="book-chip">预约</view>
      </view>
    </view>
  </view>
</view>
