<view class="page">
  <view class="title">更多功能</view>
  <view class="subtitle">集中展示滑雪服务、社区和个人辅助功能。</view>

  <view class="section grid">
    <view class="card item" hover-class="tap-hover" wx:for="{{items}}" wx:key="title" data-url="{{item.url}}" bindtap="goPage">
      <image class="item-icon" src="{{item.icon}}" mode="aspectFill" />
      <view class="item-title">{{item.title}}</view>
      <view class="subtitle">{{item.desc}}</view>
    </view>
  </view>
</view>
