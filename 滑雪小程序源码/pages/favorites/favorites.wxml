<view class="page">
  <view class="page-head">
    <view>
      <view class="title">我的收藏</view>
      <view class="subtitle">收藏雪场、装备和社区内容。</view>
    </view>
    <view class="count-pill">{{favorites.length}} 项</view>
  </view>
  <view wx:if="{{favorites.length === 0}}" class="section card empty-card">暂无收藏。</view>
  <view class="section card favorite-card" wx:for="{{favorites}}" wx:key="id">
    <view>
      <view class="item-title">{{item.title}}</view>
      <view class="subtitle">{{item.desc}}</view>
    </view>
    <view class="tag">{{item.type}}</view>
  </view>
</view>
