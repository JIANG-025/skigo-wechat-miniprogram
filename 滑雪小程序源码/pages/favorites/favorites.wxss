.page-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fff2f6 100%);
  box-shadow: 0 12rpx 34rpx rgba(42, 61, 102, 0.07);
}

.hero-label {
  color: #165dff;
  font-size: 21rpx;
  font-weight: 900;
}

.hero-icon,
.empty-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
}

.favorite-card {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-title {
  font-size: 28rpx;
  font-weight: 800;
}

.empty-card {
  color: #7a8496;
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-icon {
  margin-bottom: 18rpx;
}
