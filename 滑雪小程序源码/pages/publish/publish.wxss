.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.action-card {
  min-height: 170rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f9ff 100%);
}

.action-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  margin-bottom: 14rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
}

.publish-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.label {
  margin: 22rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.select-box {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f2f6fd;
  border: 1rpx solid #e6eefb;
  color: #172033;
}

.textarea {
  width: 100%;
  height: 250rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f2f6fd;
  border: 1rpx solid #e6eefb;
  font-size: 26rpx;
}

.upload-box {
  margin-top: 22rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef6ff;
  box-shadow: inset 0 0 0 2rpx rgba(22, 93, 255, 0.08);
}

.upload-image {
  width: 100%;
  height: 100%;
}

.submit {
  margin-top: 28rpx;
}
