.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.action-card {
  min-height: 170rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f9ff 100%);
  border: 2rpx solid transparent;
  transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
}

.action-card.active {
  border-color: rgba(22, 93, 255, 0.34);
  box-shadow: 0 18rpx 44rpx rgba(22, 93, 255, 0.12);
}

.action-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  margin-bottom: 14rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
}

.publish-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.hint-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(12, 28, 58, 0.07);
}

.hint-image {
  width: 166rpx;
  height: 132rpx;
  flex: none;
  border-radius: 24rpx;
}

.hint-copy {
  min-width: 0;
}

.hint-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
}

.label {
  margin: 22rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.select-box {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f2f6fd;
  border: 1rpx solid #e6eefb;
  color: #172033;
}

.textarea {
  width: 100%;
  height: 250rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f2f6fd;
  border: 1rpx solid #e6eefb;
  font-size: 26rpx;
}

.upload-box {
  margin-top: 22rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef6ff;
  box-shadow: inset 0 0 0 2rpx rgba(22, 93, 255, 0.08);
}

.upload-image {
  width: 100%;
  height: 100%;
}

.submit {
  margin-top: 28rpx;
}
