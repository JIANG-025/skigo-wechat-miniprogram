.page-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
  box-shadow: 0 12rpx 34rpx rgba(42, 61, 102, 0.07);
}

.hero-label {
  color: #165dff;
  font-size: 21rpx;
  font-weight: 900;
}

.hero-icon,
.empty-icon,
.card-icon {
  border-radius: 18rpx;
}

.hero-icon {
  width: 76rpx;
  height: 76rpx;
}

.tab-row {
  display: flex;
  gap: 14rpx;
}

.tab-item {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #627089;
  font-size: 24rpx;
  font-weight: 800;
}

.tab-item.active {
  background: #165dff;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(22, 93, 255, 0.18);
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
}

.empty-title,
.item-title {
  font-size: 28rpx;
  font-weight: 900;
}

.action {
  margin-top: 24rpx;
}

.reservation-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 18rpx;
}

.card-icon {
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 auto;
}

.right {
  margin-left: auto;
  text-align: right;
}
