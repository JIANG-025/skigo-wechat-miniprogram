<view class="page">
  <view class="title">我的预约</view>
  <view class="subtitle">查看教练课程预约状态和历史记录。</view>

  <view class="section tab-row">
    <view wx:for="{{tabs}}" wx:key="*this" data-tab="{{item}}" hover-class="tap-hover" bindtap="chooseTab" class="tab-item {{activeTab === item ? 'active' : ''}}">{{item}}</view>
  </view>

  <view wx:if="{{filteredReservations.length === 0}}" class="section card empty-card">
    <view class="empty-title">暂无预约记录</view>
    <view class="subtitle">可以先选择合适的教练并提交预约。</view>
    <button class="primary-btn action" hover-class="tap-hover" bindtap="goCoaches">去预约教练</button>
  </view>

  <view class="section card reservation-card" wx:for="{{filteredReservations}}" wx:key="id">
    <view>
      <view class="item-title">{{item.title}}</view>
      <view class="subtitle">{{item.type}} · {{item.createdAtText}}</view>
    </view>
    <view class="right">
      <view class="tag">{{item.status}}</view>
      <view class="price">¥{{item.price}}</view>
    </view>
  </view>
</view>
