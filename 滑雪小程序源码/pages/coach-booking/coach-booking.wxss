.page {
  padding-bottom: 170rpx;
}

.coach-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
}

.item-title,
.field-title {
  font-size: 28rpx;
  font-weight: 900;
}

.field-title {
  margin: 24rpx 0 14rpx;
}

.picker-box,
.textarea {
  border-radius: 18rpx;
  background: #f2f6fd;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}

.picker-box {
  height: 76rpx;
  line-height: 76rpx;
}

.slot-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.slot {
  min-height: 64rpx;
  border-radius: 14rpx;
  background: #f2f6fd;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #627089;
  font-size: 23rpx;
  font-weight: 800;
}

.slot.active {
  background: #165dff;
  color: #ffffff;
}

.textarea {
  width: 100%;
  height: 150rpx;
  padding-top: 20rpx;
}

.booking-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(42, 61, 102, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.total {
  font-size: 34rpx;
}

.submit {
  width: 430rpx;
  margin: 0;
}
