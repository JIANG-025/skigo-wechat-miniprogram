.page {
  padding-bottom: 230rpx;
}

.booking-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #165dff 0%, #4db8ff 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(22, 93, 255, 0.2);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.booking-hero .subtitle,
.booking-hero .price {
  color: rgba(255, 255, 255, 0.9);
}

.mini-tag {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #165dff;
  font-size: 21rpx;
  font-weight: 900;
}

.form-title {
  font-size: 32rpx;
  font-weight: 900;
}

.item-title,
.field-title {
  font-size: 28rpx;
  font-weight: 900;
}

.field-title {
  margin: 24rpx 0 14rpx;
}

.picker-box,
.textarea {
  border-radius: 18rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eefb;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}

.picker-box {
  height: 76rpx;
  line-height: 76rpx;
}

.slot-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.slot {
  min-height: 64rpx;
  border-radius: 14rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eefb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #627089;
  font-size: 23rpx;
  font-weight: 800;
}

.slot.active {
  background: #165dff;
  border-color: #165dff;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(22, 93, 255, 0.18);
}

.textarea {
  width: 100%;
  height: 150rpx;
  padding-top: 20rpx;
}

.booking-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(42, 61, 102, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.total {
  font-size: 34rpx;
}

.submit {
  width: 430rpx;
  margin: 0;
}
