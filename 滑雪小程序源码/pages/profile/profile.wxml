<view class="page">
  <view class="card profile-card">
    <view class="avatar">{{profile.initial}}</view>
    <view class="profile-main">
      <view class="title">{{profile.nickname}}</view>
      <view class="subtitle">{{profile.level}}</view>
    </view>
    <view class="link" hover-class="tap-hover" bindtap="editProfile">编辑</view>
  </view>

  <view class="section action-grid">
    <view class="card action-card" hover-class="tap-hover" data-url="/pages/orders/orders" bindtap="goPage">
      <view class="action-value">{{orderCount}}</view>
      <view class="subtitle">我的订单</view>
    </view>
    <view class="card action-card" hover-class="tap-hover" data-url="/pages/favorites/favorites" bindtap="goPage">
      <view class="action-value">{{favoriteCount}}</view>
      <view class="subtitle">我的收藏</view>
    </view>
  </view>

  <view class="section stats-grid">
    <view class="card stat-card" wx:for="{{stats}}" wx:key="label">
      <view class="stat-value">{{item.value}}</view>
      <view class="subtitle">{{item.label}}</view>
    </view>
  </view>

  <view class="section card menu-grid">
    <view class="menu-item" hover-class="tap-hover" wx:for="{{menus}}" wx:key="label" data-url="{{item.url}}" bindtap="goPage">
      {{item.label}}
    </view>
  </view>

  <view class="section">
    <view class="title-row">
      <view class="title">最近订单</view>
      <view class="link" data-url="/pages/orders/orders" bindtap="goPage">查看全部</view>
    </view>
    <view wx:if="{{recentOrders.length === 0}}" class="card empty-row">暂无订单</view>
    <view class="card list-row" wx:for="{{recentOrders}}" wx:key="id">
      <view>
        <view class="item-title">{{item.title}}</view>
        <view class="subtitle">{{item.type}} · {{item.createdAtText}}</view>
      </view>
      <view class="tag">{{item.status}}</view>
    </view>
  </view>

  <view class="section">
    <view class="title-row">
      <view class="title">最近收藏</view>
      <view class="link" data-url="/pages/favorites/favorites" bindtap="goPage">查看全部</view>
    </view>
    <view wx:if="{{recentFavorites.length === 0}}" class="card empty-row">暂无收藏</view>
    <view class="card list-row" wx:for="{{recentFavorites}}" wx:key="id">
      <view>
        <view class="item-title">{{item.title}}</view>
        <view class="subtitle">{{item.desc}}</view>
      </view>
      <view class="tag">{{item.type}}</view>
    </view>
  </view>
</view>
