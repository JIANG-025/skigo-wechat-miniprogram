.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #165dff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 38rpx;
}

.profile-main {
  flex: 1;
}

.profile-badge {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #165dff;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.action-card {
  padding: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f6f9ff 100%);
}

.action-value {
  color: #165dff;
  font-size: 42rpx;
  font-weight: 900;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.stat-card {
  text-align: center;
  padding: 24rpx 10rpx;
}

.stat-value {
  color: #165dff;
  font-size: 40rpx;
  font-weight: 900;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.menu-item {
  min-height: 124rpx;
  border-radius: 18rpx;
  background: #f5f8ff;
  color: #1f2b42;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: #165dff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.list-row {
  margin-bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 800;
}

.empty-row {
  color: #7a8496;
  text-align: center;
}
