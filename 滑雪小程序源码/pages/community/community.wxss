.publish-btn {
  width: 120rpx;
}

.post-card {
  margin-bottom: 22rpx;
  transition: transform 160ms ease, box-shadow 160ms ease, opacity 160ms ease;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.item-title {
  font-size: 28rpx;
  font-weight: 800;
}

.post-text {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.post-images {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.post-images.single {
  grid-template-columns: 1fr;
}

.post-image {
  width: 100%;
  height: 150rpx;
  border-radius: 14rpx;
  background: #edf4ff;
}

.post-images.single .post-image {
  height: 260rpx;
}

.post-actions {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f7;
  display: flex;
  align-items: center;
  gap: 44rpx;
  color: #7a8496;
  font-size: 24rpx;
  font-weight: 700;
}

.action-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f0f6ff;
  color: #165dff;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease, box-shadow 160ms ease;
}

.action-pill.active {
  background: #fff0f4;
  color: #ff4d6d;
  box-shadow: 0 8rpx 18rpx rgba(255, 77, 109, 0.14);
}

.action-pill.danger {
  background: #fff7f0;
  color: #f77234;
}

.empty-card {
  color: #7a8496;
  text-align: center;
}
