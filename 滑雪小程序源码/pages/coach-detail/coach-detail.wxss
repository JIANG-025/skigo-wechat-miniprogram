.coach-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #165dff 0%, #43b8ff 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(22, 93, 255, 0.2);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #165dff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
}

.coach-head .subtitle {
  color: rgba(255, 255, 255, 0.84);
}

.coach-head .tag {
  background: rgba(255, 255, 255, 0.9);
}

.summary-row {
  margin: 20rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  text-align: center;
}

.score {
  display: block;
  color: #165dff;
  font-size: 34rpx;
  font-weight: 900;
}

.summary-row > view {
  border-radius: 22rpx;
  background: #f5f8ff;
  padding: 18rpx 8rpx;
}

.intro-box {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f7faff;
  color: #38445a;
  font-size: 26rpx;
  line-height: 1.7;
}

.info-line {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
  color: #38445a;
  font-size: 26rpx;
  line-height: 1.6;
}

.detail-block {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.block-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.pill-list {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pill-list text {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #165dff;
  font-size: 23rpx;
  font-weight: 800;
}

.button-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 16rpx;
}

.favorite-btn,
.book-btn {
  margin: 0;
}

.favorite-btn.active {
  background: #fff0f4;
  color: #ff4d6d;
}

.empty {
  color: #7a8496;
  font-size: 26rpx;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f7;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.comment-author {
  color: #165dff;
  font-weight: 900;
}

.comment-content {
  margin-top: 8rpx;
  color: #38445a;
  font-size: 27rpx;
  line-height: 1.6;
}

.comment-box {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f2f6fd;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.comment-btn {
  width: 128rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #165dff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  padding: 0;
}
