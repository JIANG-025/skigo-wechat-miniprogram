.product-hero {
  position: relative;
  height: 360rpx;
  border-radius: 28rpx;
  background: #edf6ff;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #165dff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.primary-btn {
  margin-top: 28rpx;
}

.favorite-btn {
  margin-top: 28rpx;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease, box-shadow 160ms ease;
}

.favorite-btn.active {
  background: #fff0f4;
  color: #ff4d6d;
  box-shadow: 0 8rpx 18rpx rgba(255, 77, 109, 0.14);
}
