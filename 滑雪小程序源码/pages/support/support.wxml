<view class="page">
  <view class="title">客服中心</view>
  <view class="subtitle">处理订单、雪票、装备、教练预约等服务问题。</view>

  <view class="section card">
    <view class="item-title">在线客服</view>
    <view class="subtitle">服务时间：09:00-22:00</view>
    <button class="primary-btn action" hover-class="tap-hover" bindtap="contact">联系在线客服</button>
  </view>

  <view class="section soft-row" wx:for="{{items}}" wx:key="title">
    <view class="item-title">{{item.title}}</view>
    <view class="subtitle">{{item.desc}}</view>
  </view>
</view>
