<view class="page">
  <view class="title">设置与帮助</view>
  <view class="subtitle">承载设置、保险、客服和帮助类辅助功能。</view>
  <view class="section card setting-row" wx:for="{{items}}" wx:key="*this">
    <view class="item-title">{{item}}</view>
    <view class="muted">进入</view>
  </view>

  <view class="section card reset-card">
    <view>
      <view class="item-title">数据恢复</view>
      <view class="subtitle">恢复默认帖子、订单和收藏数据。</view>
    </view>
    <button class="reset-btn" hover-class="tap-hover" bindtap="resetDemoData">重置</button>
  </view>

  <view class="section card reset-card">
    <view>
      <view class="item-title">云端连接</view>
      <view class="subtitle">检测当前小程序与云函数的连接状态。</view>
    </view>
    <button class="reset-btn" hover-class="tap-hover" bindtap="testCloudLogin">检测</button>
  </view>
</view>
