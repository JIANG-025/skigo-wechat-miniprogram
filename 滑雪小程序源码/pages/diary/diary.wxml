<view class="page">
  <view class="title">滑雪日记</view>
  <view class="subtitle">整理每一次滑雪体验、路线和训练重点。</view>
  <view class="section">
    <view class="soft-row" wx:for="{{diaries}}" wx:key="title">
      <view class="item-title">{{item.title}}</view>
      <view class="subtitle">{{item.date}} · {{item.place}}</view>
      <view class="content">{{item.content}}</view>
    </view>
  </view>
</view>
