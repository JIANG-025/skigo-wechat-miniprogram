.page {
  padding-bottom: 230rpx;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.item-title {
  font-size: 28rpx;
  font-weight: 800;
}

.post-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.75;
}

.post-images {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.post-images.single {
  grid-template-columns: 1fr;
}

.post-image {
  width: 100%;
  height: 150rpx;
  border-radius: 14rpx;
  background: #edf4ff;
}

.post-images.single .post-image {
  height: 300rpx;
}

.post-actions {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f7;
  display: flex;
  align-items: center;
  gap: 44rpx;
  color: #7a8496;
  font-size: 24rpx;
  font-weight: 700;
}

.action-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f0f6ff;
  color: #165dff;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease, box-shadow 160ms ease;
}

.action-pill.active {
  background: #fff0f4;
  color: #ff4d6d;
  box-shadow: 0 8rpx 18rpx rgba(255, 77, 109, 0.14);
}

.empty {
  color: #7a8496;
  font-size: 26rpx;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.comment-author {
  font-size: 24rpx;
  color: #165dff;
  font-weight: 800;
}

.comment-content {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.6;
}

.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(42, 61, 102, 0.08);
  display: flex;
  gap: 16rpx;
  box-sizing: border-box;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f2f6fd;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.comment-btn {
  width: 130rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #165dff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  padding: 0;
  transition: transform 160ms ease, opacity 160ms ease;
}
