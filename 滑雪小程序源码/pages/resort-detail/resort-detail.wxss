.detail-hero {
  position: relative;
  height: 430rpx;
  border-radius: 28rpx;
  padding: 36rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
  background: #10284d;
  overflow: hidden;
}

.detail-image,
.detail-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.detail-mask {
  background: linear-gradient(180deg, rgba(6, 18, 36, 0.06) 0%, rgba(6, 18, 36, 0.72) 100%);
}

.detail-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.hero-content {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 36rpx;
  z-index: 1;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 25rpx;
}

.hero-stats {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.hero-stats view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hero-stats text:first-child {
  font-size: 26rpx;
  font-weight: 900;
}

.hero-stats text:last-child {
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
}

.intro {
  color: #38445a;
  line-height: 1.8;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f7;
  font-size: 26rpx;
}

.tag-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.soft-tag,
.facility-item {
  border-radius: 999rpx;
  background: #f0f6ff;
  color: #165dff;
  font-size: 23rpx;
  font-weight: 800;
}

.soft-tag {
  padding: 10rpx 18rpx;
}

.facility-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.facility-item {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.button-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 16rpx;
}

.favorite-btn,
.book-btn {
  margin: 0;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease, box-shadow 160ms ease;
}

.favorite-btn.active {
  background: #fff0f4;
  color: #ff4d6d;
  box-shadow: 0 8rpx 18rpx rgba(255, 77, 109, 0.14);
}

.coach-row {
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: transform 160ms ease, box-shadow 160ms ease, opacity 160ms ease;
}

.coach-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.coach-name {
  font-size: 28rpx;
  font-weight: 800;
}

.coach-main {
  flex: 1;
}

.coach-bottom {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  color: #165dff;
  font-size: 24rpx;
  font-weight: 900;
}

.empty {
  color: #7a8496;
  font-size: 26rpx;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f7;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.comment-author {
  color: #165dff;
  font-weight: 900;
}

.comment-content {
  margin-top: 8rpx;
  color: #38445a;
  font-size: 27rpx;
  line-height: 1.6;
}

.comment-box {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f2f6fd;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.comment-btn {
  width: 128rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #165dff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  padding: 0;
}
